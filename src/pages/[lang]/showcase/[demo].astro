---
import InteractiveDemoPage from '../../../components/InteractiveDemoPage.astro';
import { supportedLanguages } from '../../../i18n/content.js';
export function getStaticPaths(){
  const demos={
    'operations-dashboard':'operations',
    'customer-management':'customer',
    'booking-workflow':'booking'
  } as const;
  return supportedLanguages.flatMap((lang)=>Object.entries(demos).map(([slug,demo])=>({params:{lang,demo:slug},props:{lang,demo}})));
}
const {lang,demo}=Astro.props as {lang:'en'|'zh'|'ms';demo:'operations'|'customer'|'booking'};
---
<InteractiveDemoPage lang={lang} demo={demo}/>
