---
import PageChrome from './PageChrome.astro';
import InspectionStationPreview from './InspectionStationPreview.astro';
import { getContent, translations } from '../i18n/content.js';
import { getPhase4Content, phase4Translations } from '../i18n/phase4.js';
import { routeFor } from '../utils/routes.js';
import modelUrl from '../../assets/models/precision-inspection-station.glb?url';
import '../styles/inspection-station.css';

type Language=keyof typeof translations;
const {lang='en'}=Astro.props as {lang?:Language};
const t=getContent(lang);
const copy=getPhase4Content(lang).station as typeof phase4Translations.en.station;
const viewerCopy=JSON.stringify({
  loading:copy.loading,
  fallbackTitle:copy.fallbackTitle,
  fallbackText:copy.fallbackText,
  structureReady:copy.structureReady,
  structureMissing:copy.structureMissing,
  noSelectionTitle:copy.noSelectionTitle,
  noSelectionText:copy.noSelectionText,
  componentDetails:copy.componentDetails,
  states:copy.states,
  messages:copy.messages
}).replace(/</g,'\\u003c');
const components=['MainChassis','InspectionChamber','OpticalAssembly','ConveyorAssembly','ControlModule','CoolingAssembly','MechanicalConnections','CableAssembly'] as const;
const detailComponents=['OpticalLens','InspectionHead','ConveyorRollers','ControlPanel','CoolingFans'] as const;
---
<PageChrome lang={lang} t={t} meta={copy.meta} currentPage="showcase" pageKey="showcase/inspection-station" pathname={routeFor(lang,'showcase/inspection-station')} bodyClass="inner-page inspection-page">
  <main id="main">
    <section class="inspection-hero dark-section" id="top">
      <div class="container inspection-hero-grid">
        <div class="reveal">
          <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routeFor(lang,'home')}>{t.nav.home}</a><span>/</span><a href={routeFor(lang,'showcase')}>{t.nav.showcase}</a><span>/</span><b>{copy.title}</b></nav>
          <p class="eyebrow"><span></span>{copy.eyebrow}</p>
          <h1>{copy.title}</h1>
          <p class="inspection-subtitle">{copy.subtitle}</p>
          <p class="inspection-lead">{copy.lead}</p>
          <a class="twin-back" href={routeFor(lang,'showcase')}>← {copy.back}</a>
        </div>
        <div class="inspection-hero-specs reveal" aria-label={copy.specifications}>
          <span>{copy.originalLabel}</span>
          <dl><div><dt>{copy.dimensions}</dt><dd>4.33 × 2.34 × 2.96 m</dd></div><div><dt>{copy.components}</dt><dd>8</dd></div><div><dt>{copy.geometry}</dt><dd>115,140</dd></div></dl>
        </div>
      </div>
    </section>

    <section class="inspection-experience dark-section">
      <div class="container">
        <div class="inspection-layout" data-inspection-viewer data-model-url={modelUrl}>
          <div class="inspection-stage" data-viewer-stage>
            <canvas data-viewer-canvas aria-label={copy.canvasLabel}></canvas>
            <div class="inspection-cover" data-viewer-cover>
              <InspectionStationPreview alt={copy.coverAlt}/>
              <div class="inspection-cover-shade"></div>
              <div class="inspection-launch-panel">
                <span>{copy.coverLabel}</span>
                <button class="btn btn-mint" type="button" data-viewer-launch>{copy.launch}<span>↗</span></button>
                <p>{copy.launchHint}</p>
              </div>
            </div>
            <div class="inspection-loading" data-viewer-loading hidden><i></i><b>{copy.loading}</b><span data-viewer-progress>0%</span></div>
            <div class="inspection-fallback" data-viewer-fallback hidden><b data-viewer-fallback-title>{copy.fallbackTitle}</b><p data-viewer-fallback-text>{copy.fallbackText}</p></div>
            <div class="inspection-views" data-viewer-controls hidden aria-label={copy.viewControls}>
              <button type="button" data-view="front">{copy.views.front}</button>
              <button type="button" data-view="side">{copy.views.side}</button>
              <button type="button" data-view="rear">{copy.views.rear}</button>
              <button type="button" data-view="three-quarter" aria-pressed="true">{copy.views.threeQuarter}</button>
              <button type="button" data-view="reset">{copy.views.reset}</button>
            </div>
            <div class="inspection-component-label" data-component-label hidden><i></i><span data-label-code></span><b data-label-name></b></div>
            <div class="inspection-hud"><span>PIS–400</span><small>{copy.sceneHelp}</small></div>
          </div>

          <aside class="inspection-info">
            <span class="inspection-concept-label">{copy.originalLabel}</span>
            <h2>{copy.title}</h2>
            <p class="inspection-info-kicker">{copy.subtitle}</p>
            <div class="inspection-state-bar"><span>{copy.explorerTitle}</span><b data-assembly-state>{copy.states.assembled}</b></div>

            <section class="inspection-selected-panel" aria-live="polite">
              <span>{copy.selectedComponent}</span>
              <h3 data-selected-name>{copy.noSelectionTitle}</h3>
              <p data-selected-intro>{copy.noSelectionText}</p>
              <dl data-selected-details hidden><div><dt>{copy.systemLabel}</dt><dd data-selected-system></dd></div><div><dt>{copy.functionLabel}</dt><dd data-selected-function></dd></div><div><dt>{copy.constructionLabel}</dt><dd data-selected-construction></dd></div></dl>
              <div class="inspection-component-actions"><button type="button" data-action="focus" disabled>{copy.actions.focus}</button><button type="button" data-action="isolate" disabled>{copy.actions.isolate}</button><button type="button" data-action="show-full" disabled>{copy.actions.showFull}</button><button type="button" data-action="clear-selection" disabled>{copy.actions.clearSelection}</button></div>
            </section>

            <section class="inspection-assembly-tools"><h3>{copy.assemblyControls}</h3><div><button type="button" data-action="explode" disabled>{copy.actions.explode}</button><button type="button" data-action="reassemble" disabled>{copy.actions.reassemble}</button><button type="button" data-action="reset-all" disabled>{copy.actions.resetAll}</button></div><p role="status" data-viewer-activity>{copy.messages.ready}</p></section>

            <div class="inspection-components"><h3>{copy.componentGroups}</h3><ul>{components.map((component,index)=><li><button type="button" data-select-component={component} data-component-name={component} aria-pressed="false" disabled><i>{String(index+1).padStart(2,'0')}</i><span>{copy.componentDetails[component].name}</span></button></li>)}</ul></div>
            <div class="inspection-detail-components"><h3>{copy.keyDetails}</h3><div>{detailComponents.map((component)=><button type="button" data-select-component={component} aria-pressed="false" disabled>{copy.componentDetails[component].name}</button>)}</div></div>
            <p class="inspection-structure-status" data-components-status>{copy.structurePending}</p>
            <div class="inspection-quick-guide"><h3>{copy.interactionGuide}</h3><ul>{copy.hints.map((hint,index)=><li><i>{index+1}</i>{hint}</li>)}</ul></div>
            <div class="inspection-original-note"><b>{copy.originalNoteTitle}</b><p>{copy.originalNote}</p></div>
          </aside>
        </div>
      </div>
    </section>

    <section class="section inspection-notes light-section"><div class="container"><div class="section-heading reveal"><p class="eyebrow dark"><span></span>{copy.notesEyebrow}</p><h2>{copy.notesTitle}</h2></div><div class="inspection-notes-grid">{copy.notes.map((item,index)=><article class="reveal"><span>0{index+1}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></div></section>
  </main>
  <script type="application/json" data-viewer-copy set:html={viewerCopy}></script>
  <script>import '../scripts/inspection-station/index.js';</script>
</PageChrome>
