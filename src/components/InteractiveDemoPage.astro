---
import PageChrome from './PageChrome.astro';
import { getContent, translations } from '../i18n/content.js';
import { getPhase3Content, phase3Translations } from '../i18n/phase3.js';
import { routeFor } from '../utils/routes.js';
import { getOperationsData } from '../data/showcase/operations.js';
import { getCustomerData } from '../data/showcase/customers.js';
import { getBookingData } from '../data/showcase/bookings.js';
import demoScriptUrl from '../scripts/showcase.js?url';
type Language=keyof typeof translations;
type DemoType='operations'|'customer'|'booking';
const {lang='en',demo='operations'}=Astro.props as {lang?:Language;demo?:DemoType};
const t=getContent(lang); const p3=getPhase3Content(lang) as typeof phase3Translations.en; const common=p3.common;
const operationCopy=p3.operations; const customerCopy=p3.customer; const bookingCopy=p3.booking;
const copy=demo==='operations'?operationCopy:demo==='customer'?customerCopy:bookingCopy;
const slugs={operations:'operations-dashboard',customer:'customer-management',booking:'booking-workflow'};
const operationsData=getOperationsData(lang); const customerData=getCustomerData(lang); const bookingData=getBookingData(lang);
const data=demo==='operations'?operationsData:demo==='customer'?customerData:bookingData;
const safeData=JSON.stringify(data).replace(/</g,'\\u003c');
const initialCustomer=customerData.customers[0];
const initialBooking=bookingData.orders[0];
---
<PageChrome lang={lang} t={t} meta={copy.meta} currentPage="showcase" pageKey={`showcase/${slugs[demo]}`} pathname={routeFor(lang,`showcase/${slugs[demo]}`)} bodyClass={`inner-page demo-page demo-${demo}`}>
  <main id="main">
    <section class="demo-hero dark-section" id="top"><div class="container demo-hero-grid"><div class="reveal"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={routeFor(lang,'home')}>{t.nav.home}</a><span>/</span><a href={routeFor(lang,'showcase')}>{t.nav.showcase}</a><span>/</span><b>{copy.category}</b></nav><p class="eyebrow"><span></span>{common.conceptLabel}</p><h1>{copy.title}</h1><p>{copy.lead}</p><div class="demo-hero-actions"><span>{common.demoData}</span><a href={routeFor(lang,'showcase')}>← {common.back}</a></div></div><div class="demo-brand-panel reveal"><small>{copy.category}</small><b>{copy.name}</b><i>GS / LAB</i></div></div></section>

    {demo==='operations' && <section class="demo-section light-section"><div class="container"><div class="demo-toolbar"><div><span class="demo-live-dot"></span>{common.demoData}</div><button class="demo-reset" type="button" data-demo-reset>↺ {common.reset}</button></div><div class="software-frame operations-app" data-demo="operations">
      <aside class="ops-sidebar"><div class="app-wordmark">NO</div><nav aria-label={operationCopy.category}>{operationCopy.nav.map((label,index)=><button type="button" class:list={{active:index===0}} data-demo-nav={['overview','transactions','activity','settings'][index]}><i>{['◇','≡','◌','⚙'][index]}</i><span>{label}</span></button>)}</nav></aside>
      <div class="ops-main"><header><div><small>{operationCopy.name}</small><h2 data-ops-view-title>{operationCopy.overview}</h2></div><div class="range-switch" aria-label={operationCopy.range}>{Object.entries(operationsData.rangeLabels).map(([key,label],index)=><button type="button" class:list={{active:index===0}} data-range={key}>{label}</button>)}</div></header>
        <div data-ops-view="overview"><div class="ops-kpis">{operationsData.series.week.kpis.map((value,index)=><article><span>{operationsData.kpiLabels[index]}</span><b data-kpi={index}>{value}</b><i>DEMO</i></article>)}</div><section class="ops-panel chart-panel"><div class="panel-head"><div><small>{operationCopy.chart}</small><h3 data-chart-title>{operationCopy.revenue}</h3></div><div class="metric-switch"><button class="active" type="button" data-metric="revenue">{operationCopy.revenue}</button><button type="button" data-metric="orders">{operationCopy.orders}</button></div></div><div class="demo-chart" aria-label={operationCopy.chart}>{operationsData.series.week.revenue.map((value)=><i data-chart-bar style={`--value:${value}%`}><span></span></i>)}</div></section></div>
        <div data-ops-view="transactions"><section class="ops-panel"><div class="panel-head"><h3>{operationCopy.transactions}</h3><label><span>{operationCopy.filter}</span><select data-transaction-filter><option value="all">{operationCopy.all}</option>{Object.entries(operationsData.statusLabels).map(([key,label])=><option value={key}>{label}</option>)}</select></label></div><div class="table-scroll"><table><thead><tr><th>{operationCopy.table.id}</th><th>{operationCopy.table.customer}</th><th>{operationCopy.table.amount}</th><th>{operationCopy.table.status}</th></tr></thead><tbody data-transaction-rows>{operationsData.transactions.map((item)=><tr><td>{item.id}</td><td>{item.customer}</td><td>{item.amount}</td><td><span class={`status-pill ${item.status}`}>{item.statusLabel}</span></td></tr>)}</tbody></table></div><p class="empty-state" data-transaction-empty hidden>{common.empty}</p></section></div>
        <div data-ops-view="activity"><section class="ops-panel"><div class="panel-head"><h3>{operationCopy.activity}</h3></div><ol class="activity-feed">{operationsData.activities.map((item:string,index:number)=><li><i></i><div><b>{item}</b><span>{index+1}h · DEMO</span></div></li>)}</ol></section></div>
        <div data-ops-view="settings"><section class="ops-panel settings-panel"><span>⚙</span><h3>{operationCopy.nav[3]}</h3><p>{operationCopy.settingsText}</p></section></div>
        <p class="demo-status" role="status" aria-live="polite" data-demo-status></p>
      </div>
    </div></div></section>}

    {demo==='customer' && <section class="demo-section light-section"><div class="container"><div class="demo-toolbar"><div><span class="demo-live-dot"></span>{common.demoData}</div><button class="demo-reset" type="button" data-demo-reset>↺ {common.reset}</button></div><div class="software-frame crm-app" data-demo="customer">
      <header class="crm-top"><div class="app-wordmark">CO</div><div><small>{customerCopy.category}</small><h2>{customerCopy.name}</h2></div><label class="crm-search"><span class="sr-only">{customerCopy.search}</span><input type="search" data-customer-search placeholder={customerCopy.searchPlaceholder}/></label><label class="crm-filter"><span>{customerCopy.filter}</span><select data-customer-filter><option value="all">{customerCopy.all}</option>{Object.entries(customerData.statuses).map(([key,label])=><option value={key}>{label}</option>)}</select></label></header>
      <div class="crm-workspace"><section class="crm-list-panel"><div class="panel-head"><h3>{customerCopy.list}</h3><span data-customer-count>{customerData.customers.length}</span></div><div class="customer-list" data-customer-list>{customerData.customers.map((item,index)=><button type="button" class:list={{active:index===0}} data-customer-id={item.id}><span>{item.name.split(' ').map((part)=>part[0]).join('')}</span><div><b>{item.name}</b><small>{item.company}</small></div><i class={`status-dot ${item.status}`}></i></button>)}</div><p class="empty-state" data-customer-empty hidden>{common.empty}</p></section>
        <section class="crm-detail-panel" data-customer-detail><div class="crm-profile"><div class="crm-avatar" data-customer-initials>{initialCustomer.name.split(' ').map((part)=>part[0]).join('')}</div><div><small>{customerCopy.detail}</small><h3 data-customer-name tabindex="-1">{initialCustomer.name}</h3><p data-customer-company>{initialCustomer.company}</p></div></div><dl><div><dt>{customerCopy.email}</dt><dd data-customer-email>{initialCustomer.email}</dd></div><div><dt>{customerCopy.lastContact}</dt><dd data-customer-contact>{initialCustomer.lastContact}</dd></div></dl><div class="customer-tags"><small>{customerCopy.tags}</small><div data-customer-tags>{initialCustomer.tags.map((tag)=><span>{tag}</span>)}</div></div><label class="status-editor"><span>{customerCopy.status}</span><select data-customer-status>{Object.entries(customerData.statuses).map(([key,label])=><option value={key} selected={key===initialCustomer.status}>{label}</option>)}</select></label><button class="app-action" type="button" data-customer-update>{customerCopy.update}</button><div class="customer-history"><h4>{customerCopy.activity}</h4><ol data-customer-activity>{initialCustomer.activities.map((item:{text:string;date:string})=><li><i></i><div><b>{item.text}</b><span>{item.date}</span></div></li>)}</ol></div></section>
      </div><p class="demo-status" role="status" aria-live="polite" data-demo-status></p>
    </div></div></section>}

    {demo==='booking' && <section class="demo-section light-section"><div class="container"><div class="demo-toolbar"><div><span class="demo-live-dot"></span>{common.demoData}</div><button class="demo-reset" type="button" data-demo-reset>↺ {common.reset}</button></div><div class="software-frame booking-app" data-demo="booking">
      <header class="booking-top"><div><div class="app-wordmark">FR</div><div><small>{bookingCopy.category}</small><h2>{bookingCopy.name}</h2></div></div><label><span>{bookingCopy.filter}</span><select data-booking-filter><option value="all">{bookingCopy.all}</option>{Object.entries(bookingData.statuses).map(([key,label])=><option value={key}>{label}</option>)}</select></label></header>
      <div class="booking-kpis"><article><span>{bookingCopy.overview}</span><b data-booking-total>{bookingData.orders.length}</b></article>{Object.entries(bookingData.statuses).slice(0,3).map(([key,label])=><article><span>{label}</span><b data-booking-kpi={key}>{bookingData.orders.filter((item)=>item.status===key).length}</b></article>)}</div>
      <div class="booking-workspace"><section class="booking-list-panel"><div class="panel-head"><h3>{bookingCopy.orders}</h3></div><div class="table-scroll"><table><thead><tr><th>ID</th><th>{bookingCopy.customer}</th><th>{bookingCopy.schedule}</th><th>{bookingCopy.status}</th><th></th></tr></thead><tbody data-booking-rows>{bookingData.orders.map((item)=><tr class:list={{active:item.id===initialBooking.id}} data-booking-row={item.id}><td><b>{item.id}</b></td><td>{item.customer}</td><td>{item.schedule}</td><td><span class={`status-pill ${item.status}`}>{item.statusLabel}</span></td><td><button type="button" data-booking-id={item.id}>{bookingCopy.view}</button></td></tr>)}</tbody></table></div><p class="empty-state" data-booking-empty hidden>{common.empty}</p></section>
        <aside class="booking-detail-panel"><small>{bookingCopy.details}</small><h3 data-booking-id-label tabindex="-1">{initialBooking.id}</h3><span class={`status-pill ${initialBooking.status}`} data-booking-status-label>{initialBooking.statusLabel}</span><dl><div><dt>{bookingCopy.customer}</dt><dd data-booking-customer>{initialBooking.customer}</dd></div><div><dt>{bookingCopy.service}</dt><dd data-booking-service>{initialBooking.service}</dd></div><div><dt>{bookingCopy.schedule}</dt><dd data-booking-schedule>{initialBooking.schedule}</dd></div><div><dt>{bookingCopy.amount}</dt><dd data-booking-amount>{initialBooking.amount}</dd></div></dl><div class="workflow-timeline" data-workflow-timeline><h4>{bookingCopy.timeline}</h4>{(['pending','confirmed','completed'] as const).map((key,index)=><span class:list={{complete:index===0}} data-workflow-step={key}><i>{index+1}</i><b>{bookingData.statuses[key]}</b></span>)}</div><div class="booking-actions"><button class="app-action" type="button" data-booking-advance>{bookingCopy.advance}</button><button class="app-action secondary" type="button" data-booking-cancel>{bookingCopy.cancel}</button></div><p class="terminal-note" data-booking-terminal hidden>{bookingCopy.terminal}</p></aside>
      </div><p class="demo-status" role="status" aria-live="polite" data-demo-status></p>
    </div></div></section>}

    <section class="demo-contact dark-section"><div class="container"><p>{common.conceptLabel}</p><h2>{copy.title}</h2><a class="btn btn-mint" href={routeFor(lang,'contact')}>{common.contact}<span>↗</span></a></div></section>
  </main>
  <script type="application/json" data-demo-data set:html={safeData}></script>
  <script type="application/json" data-demo-copy set:html={JSON.stringify({common,copy}).replace(/</g,'\\u003c')}></script>
  <script src={demoScriptUrl} type="module"></script>
</PageChrome>
