---
import PageChrome from './PageChrome.astro';
import DigitalTwinPreview from './DigitalTwinPreview.astro';
import InspectionStationPreview from './InspectionStationPreview.astro';
import ContactCTA from './ContactCTA.astro';
import { getContent, translations } from '../i18n/content.js';
import { getPhase2Content } from '../i18n/phase2.js';
import { getPhase3Content, phase3Translations } from '../i18n/phase3.js';
import { getPhase4Content, phase4Translations } from '../i18n/phase4.js';
import { routeFor } from '../utils/routes.js';
type Language=keyof typeof translations;
const {lang='en'}=Astro.props as {lang?:Language};
const t=getContent(lang);const p2=getPhase2Content(lang);const p3=getPhase3Content(lang) as typeof phase3Translations.en;const p4=getPhase4Content(lang) as typeof phase4Translations.en;const copy=p4.lab;
---
<PageChrome lang={lang} t={t} meta={copy.meta} currentPage="showcase" pathname={routeFor(lang,'showcase')} bodyClass="inner-page showcase-page lab-page">
  <main id="main">
    <section class="lab-premium-hero dark-section" id="top">
      <div class="lab-hero-grid container">
        <div class="lab-hero-copy reveal">
          <p class="eyebrow"><span></span>{copy.eyebrow}</p>
          <small class="lab-section-index">{copy.introLabel}</small>
          <h1>{copy.title}</h1>
          <p>{copy.lead}</p>
          <div class="lab-hero-actions"><a class="btn btn-mint" href={routeFor(lang,'showcase/inspection-station')}>{copy.launch}<span>↗</span></a><a class="lab-text-link" href="#engineering">{copy.capabilitiesTitle}<span>↓</span></a></div>
        </div>
        <a class="lab-hero-product reveal" href={routeFor(lang,'showcase/inspection-station')} aria-label={`${copy.launch}: ${copy.stationTitle}`}>
          <InspectionStationPreview alt={copy.stationTitle} loading="eager" priority sizes="(max-width: 1050px) 100vw, 58vw"/>
          <div class="lab-product-caption"><span>{copy.flagship}</span><strong>{copy.stationTitle}</strong><small>{copy.stationSubtitle}</small></div>
          <div class="lab-product-status"><i></i>{copy.noDownload}</div>
        </a>
      </div>
    </section>

    <section class="lab-featured dark-section" aria-labelledby="featured-title">
      <div class="container">
        <div class="lab-featured-heading reveal"><div><small class="lab-section-index">{copy.flagship}</small><h2 id="featured-title">{copy.stationTitle}</h2></div><div><strong>{copy.stationSubtitle}</strong><p>{copy.stationText}</p><a class="lab-text-link" href={routeFor(lang,'showcase/inspection-station')}>{copy.launch}<span>↗</span></a></div></div>
        <div class="lab-feature-manifest">{copy.featurePoints.map((item,index)=><article class="reveal"><span>0{index+1}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div>
      </div>
    </section>

    <section class="section lab-capabilities light-section" id="engineering" aria-labelledby="capabilities-title">
      <div class="container">
        <div class="lab-capabilities-heading reveal"><small class="lab-section-index dark">{copy.capabilitiesEyebrow}</small><h2 id="capabilities-title">{copy.capabilitiesTitle}</h2><p>{copy.capabilitiesText}</p></div>
        <div class="lab-capabilities-list">{copy.capabilities.map((item,index)=><article class="reveal"><span>0{index+1}</span><div><h3>{item[0]}</h3><p>{item[1]}</p></div></article>)}</div>
      </div>
    </section>

    <section class="section lab-secondary dark-section" aria-labelledby="twin-title">
      <div class="container"><article class="lab-secondary-experiment reveal"><div class="lab-secondary-visual"><DigitalTwinPreview compact/></div><div class="lab-secondary-copy"><small class="lab-section-index">{copy.twinEyebrow}</small><h2 id="twin-title">{copy.twinTitle}</h2><p>{copy.twinText}</p><span>{copy.twinMeta}</span><a class="btn btn-ghost" href={routeFor(lang,'showcase/digital-twin')}>{copy.twinLaunch}<b>↗</b></a></div></article></div>
    </section>

    <section class="section lab-archive light-section"><div class="container"><div class="lab-archive-head reveal"><div><small class="lab-section-index dark">{copy.archiveEyebrow}</small><h2>{copy.archiveTitle}</h2></div><p>{copy.archiveText}</p></div><div class="lab-archive-grid">{p3.showcase.cards.map((card,index)=><a class="lab-archive-card reveal" href={routeFor(lang,`showcase/${card.slug}`)}><span>0{index+1}</span><p>{card.category}</p><h3>{card.name}</h3><small>{copy.explore} ↗</small></a>)}</div></div></section>
    <ContactCTA lang={lang} copy={p2.common}/>
  </main>
</PageChrome>
