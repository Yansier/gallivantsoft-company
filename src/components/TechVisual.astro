---
const { copy } = Astro.props;
---
<div class="tech-stage" aria-label={copy.visualLabel} role="img">
  <div class="stage-grid" aria-hidden="true"></div>
  <div class="orbit orbit-a" aria-hidden="true"></div><div class="orbit orbit-b" aria-hidden="true"></div>
  <div class="dashboard-window float-a">
    <div class="window-bar"><span></span><span></span><span></span><b>GS / CONTROL</b></div>
    <div class="dashboard-body">
      <aside><i></i><i></i><i></i><i></i></aside>
      <div class="dashboard-main">
        <div class="dash-head"><span>{copy.dashboard}</span><b>LIVE</b></div>
        <div class="chart"><svg viewBox="0 0 300 105" preserveAspectRatio="none"><defs><linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#3A86FF" stop-opacity=".45"/><stop offset="1" stop-color="#3A86FF" stop-opacity="0"/></linearGradient></defs><path d="M0 88 38 72 76 78 112 42 150 55 190 25 230 35 268 12 300 20V105H0Z" fill="url(#chart-fill)"/><path d="M0 88 38 72 76 78 112 42 150 55 190 25 230 35 268 12 300 20" fill="none" stroke="#4EE1C1" stroke-width="3"/></svg></div>
        <div class="metric-row"><span><i></i><b>Product</b><small>Ready</small></span><span><i></i><b>Data</b><small>Synced</small></span><span><i></i><b>Release</b><small>Stable</small></span></div>
      </div>
    </div>
  </div>
  <div class="phone-mock float-b"><div class="phone-top"></div><div class="phone-logo"><img src="/logo-mark.svg" alt=""/></div><span>{copy.mobile}</span><div class="phone-lines"><i></i><i></i><i></i></div><button tabindex="-1">↗</button></div>
  <div class="status-card api-card float-c"><span class="status-icon">⌁</span><p><b>{copy.api}</b><small>REST · WEBHOOK</small></p><i></i></div>
  <div class="status-card sync-card float-d"><span class="status-icon">✓</span><p><b>{copy.uptime}</b><small>WEB · MOBILE · CLOUD</small></p></div>
</div>

<style>
  .tech-stage{position:relative;min-height:39rem;display:grid;place-items:center;isolation:isolate}.stage-grid{position:absolute;inset:7% 4%;opacity:.18;background-image:linear-gradient(rgba(78,225,193,.3) 1px,transparent 1px),linear-gradient(90deg,rgba(78,225,193,.3) 1px,transparent 1px);background-size:42px 42px;mask-image:radial-gradient(circle,#000 25%,transparent 72%)}.orbit{position:absolute;border:1px solid rgba(78,225,193,.15);border-radius:50%}.orbit-a{width:32rem;height:32rem}.orbit-b{width:25rem;height:25rem;border-style:dashed}.dashboard-window{position:relative;z-index:2;width:min(34rem,88%);overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:1.35rem;background:rgba(15,28,61,.82);box-shadow:0 40px 90px rgba(2,8,25,.45);backdrop-filter:blur(18px)}.window-bar{height:2.65rem;display:flex;align-items:center;gap:.4rem;padding:0 1rem;border-bottom:1px solid rgba(255,255,255,.08)}.window-bar span{width:.48rem;height:.48rem;border-radius:50%;background:#4ee1c1}.window-bar span:nth-child(2){background:#3a86ff}.window-bar span:nth-child(3){background:#96a5c7}.window-bar b{margin-left:auto;color:#7f91b7;font:600 .57rem/1 system-ui;letter-spacing:.16em}.dashboard-body{display:grid;grid-template-columns:3.6rem 1fr;min-height:18rem}.dashboard-body aside{display:flex;flex-direction:column;align-items:center;gap:1.1rem;padding-top:1.6rem;border-right:1px solid rgba(255,255,255,.07)}.dashboard-body aside i{width:1.15rem;height:1.15rem;border:1px solid #61749e;border-radius:.35rem}.dashboard-main{padding:1.5rem}.dash-head{display:flex;justify-content:space-between;color:#fff;font-size:.72rem}.dash-head b{color:#4ee1c1;font-size:.55rem;letter-spacing:.12em}.chart{height:7.8rem;margin:1.3rem 0 .8rem;border-bottom:1px solid rgba(255,255,255,.08)}.chart svg{width:100%;height:100%}.metric-row{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}.metric-row span{display:grid;grid-template-columns:auto 1fr;gap:.12rem .4rem;padding:.7rem;border:1px solid rgba(255,255,255,.07);border-radius:.65rem;background:rgba(255,255,255,.025)}.metric-row i{grid-row:1/3;width:.45rem;height:.45rem;margin-top:.2rem;border-radius:50%;background:#4ee1c1}.metric-row b{color:#dfe9ff;font-size:.57rem}.metric-row small{color:#7484a8;font-size:.48rem}.phone-mock{position:absolute;z-index:4;right:1%;bottom:6%;width:8.8rem;height:17rem;padding:1rem;border:1px solid rgba(255,255,255,.22);border-radius:2rem;background:linear-gradient(160deg,#233a70,#101a39);box-shadow:0 28px 55px rgba(2,8,25,.5);transform:rotate(6deg)}.phone-top{width:3.2rem;height:.3rem;margin:0 auto 1.5rem;border-radius:1rem;background:#0b132b}.phone-logo{width:3rem;height:3rem;display:grid;place-items:center;margin:0 auto 1rem;border-radius:1rem;background:rgba(255,255,255,.09)}.phone-logo img{width:2rem}.phone-mock>span{display:block;color:#fff;font-size:.65rem;text-align:center}.phone-lines{display:grid;gap:.5rem;margin:1.4rem 0}.phone-lines i{height:.4rem;border-radius:1rem;background:rgba(255,255,255,.1)}.phone-lines i:nth-child(2){width:70%}.phone-mock button{position:absolute;right:1rem;bottom:1rem;width:2.2rem;height:2.2rem;border:0;border-radius:50%;color:#0b132b;background:#4ee1c1}.status-card{position:absolute;z-index:5;display:flex;align-items:center;gap:.65rem;padding:.75rem .9rem;border:1px solid rgba(255,255,255,.13);border-radius:.9rem;background:rgba(13,26,57,.82);box-shadow:0 18px 40px rgba(2,8,25,.32);backdrop-filter:blur(14px)}.status-icon{width:2rem;height:2rem;display:grid;place-items:center;border-radius:.65rem;color:#0b132b;background:#4ee1c1;font-weight:900}.status-card p{display:grid;gap:.18rem;margin:0}.status-card b{color:#fff;font-size:.68rem}.status-card small{color:#7f91b7;font-size:.48rem;letter-spacing:.07em}.api-card{left:0;top:15%}.sync-card{left:8%;bottom:9%}.float-a{animation:float 7s ease-in-out infinite}.float-b{animation:float 6s 1s ease-in-out infinite}.float-c{animation:float 5s .4s ease-in-out infinite}.float-d{animation:float 6.5s 1.5s ease-in-out infinite}@keyframes float{50%{translate:0 -9px}}
  @media(max-width:700px){.tech-stage{min-height:28rem}.dashboard-window{width:96%}.dashboard-body{grid-template-columns:2.6rem 1fr;min-height:15rem}.dashboard-main{padding:1rem}.metric-row span:nth-child(3){display:none}.metric-row{grid-template-columns:repeat(2,1fr)}.phone-mock{right:-.25rem;bottom:0;width:7rem;height:13.5rem}.api-card{left:.1rem;top:7%}.sync-card{display:none}.orbit-a{width:24rem;height:24rem}.orbit-b{width:19rem;height:19rem}}
  @media(prefers-reduced-motion:reduce){.float-a,.float-b,.float-c,.float-d{animation:none}}
</style>
