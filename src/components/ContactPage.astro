---
import PageChrome from './PageChrome.astro';
import PageHero from './PageHero.astro';
import { getContent, translations } from '../i18n/content.js';
import { getPhase2Content, phase2Translations } from '../i18n/phase2.js';
import { siteConfig, contactLinks } from '../config/site.js';
import { routeFor } from '../utils/routes.js';
type Language=keyof typeof translations;
const {lang='en'}=Astro.props as {lang?:Language};
const t=getContent(lang) as typeof translations.en;
const p=getPhase2Content(lang) as typeof phase2Translations.en;
const copy=p.contactPage;
---
<PageChrome lang={lang} t={t} meta={copy.meta} currentPage="contact" pathname={routeFor(lang,'contact')} bodyClass="inner-page contact-page">
  <main id="main">
    <PageHero eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} homeLabel={p.common.home} homeHref={routeFor(lang,'home')} pageLabel={t.nav.contact} variant="contact"/>
    <section class="section contact-workspace light-section">
      <div class="container contact-workspace-grid">
        <aside class="contact-channels reveal"><p class="eyebrow dark"><span></span>{copy.channelsEyebrow}</p><h2>{copy.channelsTitle}</h2><p>{copy.channelsText}</p>
          <div class="channel-list">
            <a href={contactLinks.email}><span>✉</span><div><b>{copy.email}</b><small>{siteConfig.email}</small></div><i>↗</i></a>
            <a href={contactLinks.phone}><span>☎</span><div><b>{copy.phone}</b><small>{siteConfig.phoneDisplay}</small></div><i>↗</i></a>
            <div><span>MY</span><div><b>{copy.location}</b><small>{siteConfig.country}</small></div></div>
          </div>
        </aside>
        <div class="enquiry-card reveal"><div class="enquiry-head"><p class="eyebrow dark"><span></span>{copy.formEyebrow}</p><h2>{copy.formTitle}</h2><p>{copy.formText}</p></div>
          <form data-project-form data-email={siteConfig.email} data-message-title={copy.messageTitle} data-mailto-limit="1800" novalidate>
            <label><span>{copy.fields.projectType} *</span><select name="projectType" required aria-describedby="projectType-error">{copy.projectTypes.map((option,index)=><option value={index===0?'':option}>{option}</option>)}</select><small class="field-error" id="projectType-error" data-error-for="projectType">{copy.errors.projectType}</small></label>
            <label class="full"><span>{copy.fields.description} *</span><textarea name="description" rows="6" minlength="20" maxlength="1200" required placeholder={copy.placeholders.description} aria-describedby="description-error description-help"></textarea><small id="description-help" class="field-help">{copy.descriptionLimit}</small><small class="field-error" id="description-error" data-error-for="description">{copy.errors.description}</small></label>
            <label><span>{copy.fields.budget}</span><input name="budget" type="text" maxlength="80" placeholder={copy.placeholders.budget}/></label>
            <label><span>{copy.fields.timeline}</span><input name="timeline" type="text" maxlength="80" placeholder={copy.placeholders.timeline}/></label>
            <label class="full"><span>{copy.fields.name}</span><input name="name" type="text" maxlength="80" placeholder={copy.placeholders.name}/></label>
            <div class="form-actions full"><div class="form-button-row"><button class="btn btn-primary" type="submit">{copy.submit}<span>↗</span></button><button class="btn btn-secondary" type="button" data-copy-enquiry>{copy.copy}<span>⧉</span></button></div><p>{copy.privacy}</p></div>
            <div class="enquiry-output full" data-enquiry-output hidden><label><span>{copy.copyAreaLabel}</span><textarea rows="10" readonly data-enquiry-text></textarea></label><p class="form-status" role="status" aria-live="polite" data-form-status></p></div>
            <div hidden data-message-labels data-project-type={copy.labels.projectType} data-description={copy.labels.description} data-budget={copy.labels.budget} data-timeline={copy.labels.timeline} data-name={copy.labels.name} data-copied={copy.status.copied} data-copy-manual={copy.status.copyManual} data-mailto-long={copy.status.mailtoLong} data-mail-opened={copy.status.mailOpened}></div>
          </form>
        </div>
      </div>
    </section>
  </main>
</PageChrome>
