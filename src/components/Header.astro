---
import Logo from './Logo.astro';
import { languageNames } from '../i18n/content.js';
const { t, lang, isRoot = false } = Astro.props;
const prefix = isRoot ? '' : `/${lang}`;
---
<header class="site-header" data-header>
  <div class="nav-shell">
    <a class="brand-link" href={`${prefix || '/'}#top`} aria-label="GallivantSoft home"><Logo light /></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={`${prefix || '/'}#top`}>{t.nav.home}</a><a href={`${prefix || '/'}#services`}>{t.nav.services}</a><a href={`${prefix || '/'}#solutions`}>{t.nav.solutions}</a><a href={`${prefix || '/'}#about`}>{t.nav.about}</a><a href={`${prefix || '/'}#contact`}>{t.nav.contact}</a>
    </nav>
    <div class="nav-actions">
      <label class="language-control"><span class="sr-only">{t.nav.language}</span><select data-language-select aria-label={t.nav.language}>{Object.entries(languageNames).map(([code,name])=><option value={code} selected={code===lang}>{name}</option>)}</select></label>
      <a class="nav-quote" href={`${prefix || '/'}#contact`}>{t.nav.quote}<span>↗</span></a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu"><i></i><i></i></button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" data-mobile-nav aria-label="Mobile navigation">
    <a href={`${prefix || '/'}#top`}>{t.nav.home}</a><a href={`${prefix || '/'}#services`}>{t.nav.services}</a><a href={`${prefix || '/'}#solutions`}>{t.nav.solutions}</a><a href={`${prefix || '/'}#about`}>{t.nav.about}</a><a href={`${prefix || '/'}#contact`}>{t.nav.contact}</a>
  </nav>
</header>
