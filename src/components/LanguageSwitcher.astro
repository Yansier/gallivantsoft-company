---
import { languageNames } from '../i18n/content.js';
type Language=keyof typeof languageNames;
const {lang='en',label='Language',variant='header'}=Astro.props as {lang?:Language;label?:string;variant?:'header'|'footer'};
const languageCodes:Record<Language,string>={en:'EN',zh:'ZH',ms:'MS'};
const menuId=`language-menu-${variant}`;
---
<div class:list={['language-switcher',`language-switcher-${variant}`]} data-language-switcher>
  <button class="language-trigger" type="button" data-language-trigger aria-label={label} aria-haspopup="menu" aria-expanded="false" aria-controls={menuId}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3.6 9h16.8M3.6 15h16.8M12 3c2.2 2.4 3.3 5.4 3.3 9S14.2 18.6 12 21M12 3C9.8 5.4 8.7 8.4 8.7 12s1.1 6.6 3.3 9"></path></svg>
    <span class="language-current-code">{languageCodes[lang]}</span>
    <span class="language-current-name">{languageNames[lang]}</span>
    <svg class="language-chevron" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"></path></svg>
  </button>
  <div class="language-menu" id={menuId} role="menu" aria-label={label} data-language-menu hidden>
    {(Object.entries(languageNames) as [Language,string][]).map(([code,name])=><button type="button" role="menuitemradio" aria-checked={code===lang?'true':'false'} class:list={{selected:code===lang}} data-language-option={code}><span>{name}</span><small>{languageCodes[code]}</small><i aria-hidden="true">✓</i></button>)}
  </div>
</div>
